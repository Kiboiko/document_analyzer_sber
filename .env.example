# Шаблон окружения: только ИМЕНА переменных. Значения и ключи — в .env (не в git).

# --- БД ---
DATABASE_URL=
DB_ECHO=

# --- приложение ---
APP_NAME=
DEBUG=

# --- модель: провайдер (cloud | local) ---
MODEL_PROVIDER=

# --- OCR: self-hosted olmOCR на vLLM (адрес с /v1) ---
OLMOCR_SERVER=
OLMOCR_MODEL=

# --- LLM cloud: Qwen через ilons ---
LLM_BASE_URL=
ILONS_API_KEY=
LLM_MODEL=
# Qwen у ilons — reasoning-модель, меньше 1500 не ставить
LLM_MAX_TOKENS=

# --- LLM/VLM local: Ollama ---
OLLAMA_HOST=
LOCAL_VLM_MODEL=

MODEL_TIMEOUT_S=

# --- OIDC / Keycloak ---
OIDC_ISSUER=
# Публичный адрес Keycloak для браузера (authorize/end_session), если
# отличается от OIDC_ISSUER — например, при локальном запуске app в Docker
# (OIDC_ISSUER=http://keycloak:8080/..., а браузеру нужен http://localhost:8080).
OIDC_PUBLIC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
KEYCLOAK_ADMIN_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
SESSION_SECRET=

# --- хранилище и приём ---
STORAGE_DIR=
MAX_UPLOAD_MB=
MAX_FILES_PER_REQUEST=

# --- воркер ---
WORKER_CONCURRENCY=
WORKER_POLL_INTERVAL_S=
JOB_LOCK_TIMEOUT_S=
JOB_MAX_ATTEMPTS=
