# Шаблон окружения: только ИМЕНА переменных. Значения и ключи — в .env (не в git).

# --- БД ---
DATABASE_URL=
DB_ECHO=

# --- приложение ---
APP_NAME=
DEBUG=

# --- модель: провайдер (cloud | local) ---
MODEL_PROVIDER=

# --- OCR: HTTP-сервис организаторов (по умолчанию https://ocr.ilons.ru) ---
OCR_SERVICE_URL=
# токен сервиса (X-API-Token); пусто — открытый доступ
OCR_CLIENT_TOKEN=
# таймаут запроса, секунды; дедлайн сервиса 240, меньше 300 не ставить
OCR_TIMEOUT_S=

# --- LLM cloud: Qwen через ilons ---
LLM_BASE_URL=
ILONS_API_KEY=
LLM_MODEL=
# Qwen у ilons — reasoning-модель, меньше 1500 не ставить
LLM_MAX_TOKENS=

# --- LLM/VLM local: Ollama ---
OLLAMA_HOST=
LOCAL_VLM_MODEL=

MODEL_TIMEOUT_S=

# --- OIDC / Keycloak ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
KEYCLOAK_ADMIN_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
SESSION_SECRET=

# --- хранилище и приём ---
STORAGE_DIR=
MAX_UPLOAD_MB=
MAX_FILES_PER_REQUEST=

# --- воркер ---
WORKER_CONCURRENCY=
WORKER_POLL_INTERVAL_S=
JOB_LOCK_TIMEOUT_S=
JOB_MAX_ATTEMPTS=
